worker_processes 1;
pid logs/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;

  client_body_temp_path client_body_temp;
  proxy_temp_path       proxy_temp;
  fastcgi_temp_path     fastcgi_temp;
  uwsgi_temp_path       uwsgi_temp;
  scgi_temp_path        scgi_temp;

  server {
    listen 8080;
    server_name _;

    client_max_body_size 1g;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location /dicom-web/ {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
      }

      proxy_pass http://127.0.0.1:8042/dicom-web/;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:8042;
      proxy_set_header Authorization "Basic REPLACE_WITH_BASE64";
      add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
      add_header Access-Control-Allow-Credentials "true" always;
    }

    location /studies {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
      }

      proxy_pass http://127.0.0.1:8042/studies;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:8042;
      proxy_set_header Authorization "Basic REPLACE_WITH_BASE64";
      add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
      add_header Access-Control-Allow-Credentials "true" always;
    }

    location /wado {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
      }

      proxy_pass http://127.0.0.1:8042/wado;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:8042;
      proxy_set_header Authorization "Basic REPLACE_WITH_BASE64";
      add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
      add_header Access-Control-Allow-Credentials "true" always;
    }

    location /pacs/ {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
      }

      proxy_pass http://127.0.0.1:8042/;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:8042;
      proxy_set_header Authorization "Basic REPLACE_WITH_BASE64";
      add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
      add_header Access-Control-Allow-Credentials "true" always;
    }

    location / {
      if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin" always;
        add_header Access-Control-Max-Age 86400 always;
        return 204;
      }

      proxy_pass http://127.0.0.1:8042/;
      proxy_http_version 1.1;
      proxy_set_header Host 127.0.0.1:8042;
      proxy_set_header Authorization "Basic REPLACE_WITH_BASE64";
      add_header Access-Control-Allow-Origin "https://vlm-mammogram-study.web.app" always;
      add_header Access-Control-Allow-Credentials "true" always;
    }

    location = /healthz {
      return 200 "running\n";
    }
  }
}
